# Copy to .env only if the API is not on http://localhost:8000.
#
# Use localhost, NEVER 127.0.0.1. For cookies an IP address is its own site, so
# a page served from localhost calling 127.0.0.1 is a cross-site request and the
# browser drops the SameSite=Lax session cookie. Login answers 200 and every
# call after it answers 401.
VITE_API_URL=http://localhost:8000
