# Copy to .env and fill in. .env is git-ignored, this file is not.

# --- Database ---------------------------------------------------------------
# Local Postgres from docker-compose.yml. Port 5433 on the host, because a
# native Postgres install may already be holding 5432.
DATABASE_URL=postgresql+psycopg://liga:liga@localhost:5433/liga
# Railway hands out postgresql:// URLs, which SQLAlchemy maps to psycopg2.
# The app rewrites the scheme to postgresql+psycopg:// on its own, so the
# Railway variable can be referenced as-is.

# --- Security ---------------------------------------------------------------
# At least 32 characters, or the app refuses to start.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=480
# Set to true once the API is served over HTTPS.
COOKIE_SECURE=false

# --- CORS -------------------------------------------------------------------
# Comma separated. Never "*": browsers drop cookies on a wildcard origin.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Login rate limit -------------------------------------------------------
LOGIN_MAX_ATTEMPTS=10
LOGIN_WINDOW_SECONDS=300

# --- Seed -------------------------------------------------------------------
ADMIN_EMAIL=admin@ligalaamistad.com
ADMIN_PASSWORD=change-me

# --- Cloudinary -------------------------------------------------------------
# Console -> Dashboard. The three values are on the first screen; the secret is
# behind a "reveal" button. While these are empty, image uploads answer 503
# instead of failing obscurely.
#
# Check the setup with: uv run python -m app.check_cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Folders inside the Cloudinary media library. They are created on first upload
# if they do not exist yet.
CLOUDINARY_TEAMS_FOLDER=parejas-liga-la-amistad
CLOUDINARY_SPONSORS_FOLDER=sponsors-liga-la-amistad
CLOUDINARY_MATCHES_FOLDER=partidos-liga-la-amistad
